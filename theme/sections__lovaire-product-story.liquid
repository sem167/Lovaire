{%- liquid
  assign sid = section.id | replace: '_', '' | downcase
  assign p = closest.product
  assign mf = p.metafields.lovaire
-%}
{% style %}
  .lps-{{ sid }} { background: {{ section.settings.background }}; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
  .lps-{{ sid }} .lps__inner { max-width: 1160px; margin: 0 auto; padding: 0 20px; }
  .lps-{{ sid }} .lps__head { text-align: center; margin: 0 auto 40px; max-width: 620px; }
  .lps-{{ sid }} .lps__eyebrow { display: inline-flex; align-items: center; gap: 12px; font-family: var(--font-body--family); font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: #8b6b4a; margin: 0 0 14px; }
  .lps-{{ sid }} .lps__eyebrow::before, .lps-{{ sid }} .lps__eyebrow::after { content: ""; width: 26px; height: 1px; background: #cdb8a6; }
  .lps-{{ sid }} .lps__title { font-family: var(--font-heading--family); font-weight: 400; font-size: clamp(28px, 4vw, 42px); line-height: 1.12; color: #111; margin: 0; }
  .lps-{{ sid }} .lps__title em { font-style: italic; color: #8b6b4a; }
  .lps-{{ sid }} .lps__row { display: grid; grid-template-columns: 1fr; gap: 22px; align-items: center; margin-bottom: 44px; }
  .lps-{{ sid }} .lps__row:last-child { margin-bottom: 0; }
  @media (min-width: 800px) {
    .lps-{{ sid }} .lps__row { grid-template-columns: 1fr 1fr; gap: 64px; margin-bottom: 72px; }
    .lps-{{ sid }} .lps__row:nth-child(even) .lps__media { order: 2; }
  }
  .lps-{{ sid }} .lps__media { position: relative; aspect-ratio: 4 / 5; max-height: 70vh; border-radius: 999px 999px 20px 20px; overflow: hidden; background: #efe4d9; max-width: 460px; width: 78%; justify-self: center; }
  @media (min-width: 800px) { .lps-{{ sid }} .lps__media { width: 100%; } }
  .lps-{{ sid }} .lps__row:nth-child(even) .lps__media { border-radius: 20px 20px 999px 999px; }
  .lps-{{ sid }} .lps__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .lps-{{ sid }} .lps__text { text-align: center; }
  @media (min-width: 800px) { .lps-{{ sid }} .lps__text { text-align: left; } }
  .lps-{{ sid }} .lps__no { display: block; font-family: var(--font-heading--family); font-style: italic; font-size: 14px; color: #a8896a; margin-bottom: 10px; }
  .lps-{{ sid }} .lps__text h3 { font-family: var(--font-heading--family); font-weight: 400; font-size: clamp(24px, 3vw, 34px); line-height: 1.15; color: #111; margin: 0 0 14px; }
  .lps-{{ sid }} .lps__text p { font-family: var(--font-body--family); font-size: 15px; line-height: 1.75; color: #5a5a5a; margin: 0 auto; max-width: 46ch; }
  @media (min-width: 800px) { .lps-{{ sid }} .lps__text p { margin: 0; } }
{% endstyle %}

{%- assign has_any = false -%}
{%- if mf.highlight_1_title.value != blank or mf.highlight_2_title.value != blank -%}{%- assign has_any = true -%}{%- endif -%}
{%- if has_any -%}
<section class="lps-{{ sid }}">
  <div class="lps__inner">
    <div class="lps__head">
      {%- if section.settings.eyebrow != blank -%}<p class="lps__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="lps__title">{{ section.settings.heading | escape }} <em>{{ section.settings.heading_italic | escape }}</em></h2>
    </div>
    {%- assign n = 0 -%}
    {%- for i in (1..3) -%}
      {%- capture tk -%}highlight_{{ i }}_title{%- endcapture -%}
      {%- capture xk -%}highlight_{{ i }}_text{%- endcapture -%}
      {%- assign t = mf[tk].value -%}
      {%- assign x = mf[xk].value -%}
      {%- assign tlen = t | size -%}
      {%- if t != blank and tlen > 0 -%}
        {%- assign n = n | plus: 1 -%}
        {%- assign img = p.images[i] | default: p.featured_image -%}
        <div class="lps__row">
          <div class="lps__media">{%- if img -%}{{ img | image_url: width: 1000 | image_tag: loading: 'lazy', alt: t, sizes: '(min-width: 800px) 40vw, 90vw' }}{%- endif -%}</div>
          <div class="lps__text">
            <span class="lps__no">N° 0{{ n }}</span>
            <h3>{{ t | escape }}</h3>
            <p>{{ x | escape }}</p>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Lovaire productverhaal",
  "settings": [
    { "type": "paragraph", "content": "Teksten komen uit de product-metafields lovaire.highlight_1_title / _text (t/m 3). Foto's: de 2e en 3e productfoto." },
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "WHY YOU'LL LOVE IT" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Made for your" },
    { "type": "text", "id": "heading_italic", "label": "Kop – cursief", "default": "everyday glow" },
    { "type": "color", "id": "background", "label": "Achtergrond", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "label": "Ruimte boven", "min": 0, "max": 120, "step": 4, "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Ruimte onder", "min": 0, "max": 120, "step": 4, "default": 72 }
  ],
  "presets": [{ "name": "Lovaire productverhaal" }]
}
{% endschema %}
