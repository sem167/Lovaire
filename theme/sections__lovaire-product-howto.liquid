{%- liquid
  assign sid = section.id | replace: '_', '' | downcase
  assign p = closest.product
  assign raw = p.metafields.lovaire.how_to.value
  assign steps = raw | newline_to_br | split: '<br />'
-%}
{%- if raw != blank -%}
{% style %}
  .lph-{{ sid }} { background: {% render 'lovaire-bg', bg: section.settings.background, top: section.settings.blend_top, bottom: section.settings.blend_bottom %}; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
  .lph-{{ sid }} .lph__inner { max-width: 1100px; margin: 0 auto; padding: 0 20px; text-align: center; }
  .lph-{{ sid }} .lph__eyebrow { font-family: var(--font-body--family); font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: #8b6b4a; margin: 0 0 14px; }
  .lph-{{ sid }} .lph__title { font-family: var(--font-heading--family); font-weight: 400; font-size: clamp(28px, 4vw, 40px); color: #111; margin: 0 0 36px; }
  .lph-{{ sid }} .lph__title em { font-style: italic; color: #8b6b4a; }
  .lph-{{ sid }} .lph__steps { display: grid; grid-template-columns: 1fr; gap: 14px; margin: 0; padding: 0; list-style: none; counter-reset: lph; text-align: left; }
  @media (min-width: 800px) { .lph-{{ sid }} .lph__steps { grid-template-columns: repeat({{ steps.size | at_most: 5 }}, minmax(0, 1fr)); gap: 20px; text-align: center; } }
  .lph-{{ sid }} .lph__step { counter-increment: lph; display: flex; align-items: center; gap: 16px; padding: 18px; background: #fff; border-radius: 18px; font-family: var(--font-body--family); font-size: 14px; line-height: 1.55; color: #3d3d3d; }
  @media (min-width: 800px) { .lph-{{ sid }} .lph__step { flex-direction: column; padding: 28px 20px; } }
  .lph-{{ sid }} .lph__step::before { content: counter(lph, decimal-leading-zero); flex: none; width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; border: 1px solid #cdb8a6; font-family: var(--font-heading--family); font-style: italic; font-size: 15px; color: #8b6b4a; }
{% endstyle %}
<section class="lph-{{ sid }}">
  <div class="lph__inner">
    {%- if section.settings.eyebrow != blank -%}<p class="lph__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h2 class="lph__title">{{ section.settings.heading | escape }} <em>{{ section.settings.heading_italic | escape }}</em></h2>
    <ol class="lph__steps">
      {%- for s in steps -%}{%- assign s2 = s | strip -%}{%- if s2 != blank -%}<li class="lph__step">{{ s2 | escape }}</li>{%- endif -%}{%- endfor -%}
    </ol>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Lovaire gebruik",
  "settings": [
    { "type": "paragraph", "content": "Stappen komen uit het product-metafield lovaire.how_to (één stap per regel)." },
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "HOW TO USE" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Your" },
    { "type": "text", "id": "heading_italic", "label": "Kop – cursief", "default": "routine" },
    { "type": "color", "id": "blend_top", "label": "Overloop boven (automatisch)" },
    { "type": "color", "id": "blend_bottom", "label": "Overloop onder (automatisch)" },
    { "type": "color", "id": "background", "label": "Achtergrond", "default": "#f4ece4" },
    { "type": "range", "id": "padding_top", "label": "Ruimte boven", "min": 0, "max": 120, "step": 4, "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Ruimte onder", "min": 0, "max": 120, "step": 4, "default": 72 }
  ],
  "presets": [{ "name": "Lovaire gebruik" }]
}
{% endschema %}
