    "faq": {
      "type": "section",
      "name": "Frequently asked questions",
      "blocks": {
        "heading": {
          "type": "text",
          "settings": { "text": "<h2>Frequently asked questions</h2>", "width": "100%", "max_width": "normal", "alignment": "center", "type_preset": "h2", "font": "var(--font-heading--family)", "color": "var(--color-foreground-heading)", "wrap": "pretty" },
          "blocks": {}
        },
        "acc": {
          "type": "accordion",
          "settings": { "icon": "plus", "dividers": false, "type_preset": "h5", "inherit_color_scheme": true },
          "blocks": {
            "q0": { "type": "_accordion-row", "settings": { "heading": "Which size should I choose?", "open_by_default": false, "icon": "none" }, "blocks": { "q0_t": { "type": "text", "settings": { "text": "<p>Every product page has a size chart in centimetres. Measure a favourite piece you already own and compare. In doubt between two sizes? Choose the larger one, or send us a message and we'll help you pick.</p>", "width": "100%", "max_width": "normal", "alignment": "left", "type_preset": "rte", "font": "var(--font-body--family)", "color": "var(--color-foreground)", "wrap": "pretty" }, "blocks": {} } }, "block_order": ["q0_t"] },
            "q1": { "type": "_accordion-row", "settings": { "heading": "When will I receive my order?", "open_by_default": false, "icon": "none" }, "blocks": { "q1_t": { "type": "text", "settings": { "text": "<p>As soon as your order ships, you'll receive an email with your tracking link, so you can follow your parcel every step of the way. You'll find all the details in our <a href=\"/pages/verzendbeleid\">shipping policy</a>.</p>", "width": "100%", "max_width": "normal", "alignment": "left", "type_preset": "rte", "font": "var(--font-body--family)", "color": "var(--color-foreground)", "wrap": "pretty" }, "blocks": {} } }, "block_order": ["q1_t"] },
            "q2": { "type": "_accordion-row", "settings": { "heading": "How much is shipping?", "open_by_default": false, "icon": "none" }, "blocks": { "q2_t": { "type": "text", "settings": { "text": "<p>Nothing: shipping is always free at Lovaire.</p>", "width": "100%", "max_width": "normal", "alignment": "left", "type_preset": "rte", "font": "var(--font-body--family)", "color": "var(--color-foreground)", "wrap": "pretty" }, "blocks": {} } }, "block_order": ["q2_t"] },
            "q3": { "type": "_accordion-row", "settings": { "heading": "Can I return my order?", "open_by_default": false, "icon": "none" }, "blocks": { "q3_t": { "type": "text", "settings": { "text": "<p>Yes. Clothing can be returned within 14 days of receiving it, unworn and with tags attached. Separate conditions apply to underwear, swimwear and hygiene products. Read everything on our <a href=\"/pages/bestellingen-en-levering-1\">returns and exchanges</a> page.</p>", "width": "100%", "max_width": "normal", "alignment": "left", "type_preset": "rte", "font": "var(--font-body--family)", "color": "var(--color-foreground)", "wrap": "pretty" }, "blocks": {} } }, "block_order": ["q3_t"] },
            "q4": { "type": "_accordion-row", "settings": { "heading": "Where are your products made?", "open_by_default": false, "icon": "none" }, "blocks": { "q4_t": { "type": "text", "settings": { "text": "<p>Our products are made both locally and around the world. We choose our production partners carefully, so you get quality at a fair price.</p>", "width": "100%", "max_width": "normal", "alignment": "left", "type_preset": "rte", "font": "var(--font-body--family)", "color": "var(--color-foreground)", "wrap": "pretty" }, "blocks": {} } }, "block_order": ["q4_t"] },
            "q5": { "type": "_accordion-row", "settings": { "heading": "I have a question, how can I reach you?", "open_by_default": false, "icon": "none" }, "blocks": { "q5_t": { "type": "text", "settings": { "text": "<p>Send us a message via our <a href=\"/pages/contact\">contact page</a>. We reply on weekdays between 09:00 and 17:00.</p>", "width": "100%", "max_width": "normal", "alignment": "left", "type_preset": "rte", "font": "var(--font-body--family)", "color": "var(--color-foreground)", "wrap": "pretty" }, "blocks": {} } }, "block_order": ["q5_t"] }
          },
          "block_order": ["q0", "q1", "q2", "q3", "q4", "q5"]
        }
