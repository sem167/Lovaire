{%- comment -%}
  Productcarrousel in Meroda-stijl: kop + "Bekijk alles", kaarten met lichte achtergrond, label linksboven,
  titel in hoofdletters, prijs met doorgestreepte prijs, rood "Bespaar x%"-label en een zwarte knop over de volle breedte.
  Producten met één variant gaan direct in de winkelwagen (de drawer opent), anders gaat de knop naar de productpagina.
{%- endcomment -%}
{%- assign sid = section.id | replace: '_', '' | downcase -%}
<section class="lvm-prod-{{ sid }}" data-lvm-slider>
  <div class="lvm-prod__head">
    {%- if section.settings.heading != blank -%}<h2 class="lvm-prod__h">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    {%- if section.settings.link_label != blank -%}
      <a class="lvm-prod__all" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }}</a>
    {%- endif -%}
  </div>

  <div class="lvm-prod__wrap">
    <div class="lvm-prod__track" data-lvm-track>
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- if p == blank -%}{%- continue -%}{%- endif -%}
        {%- assign v = p.selected_or_first_available_variant -%}
        <article class="lvm-prod__card" {{ block.shopify_attributes }}>
          <a class="lvm-prod__media" href="{{ p.url }}">
            {%- if block.settings.badge != blank -%}<span class="lvm-prod__badge">{{ block.settings.badge | escape }}</span>{%- endif -%}
            {%- assign card_img = block.settings.image | default: p.featured_image -%}
            {%- if card_img -%}
              {{ card_img | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 25vw, 66vw', widths: '450, 700, 900', alt: p.title }}
            {%- endif -%}
          </a>
          <div class="lvm-prod__body">
            <a class="lvm-prod__title" href="{{ p.url }}">{{ p.title | escape }}</a>
            <p class="lvm-prod__price">
              {%- if p.price_varies -%}Vanaf {% endif -%}{{ v.price | money }}
              {%- if v.compare_at_price > v.price -%}<s>{{ v.compare_at_price | money }}</s>{%- endif -%}
            </p>
            {%- if v.compare_at_price > v.price -%}
              {%- assign save = v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price -%}
              <span class="lvm-prod__save">Bespaar {{ save }}%</span>
            {%- endif -%}
          </div>
          {%- if p.available == false -%}
            <span class="lvm-prod__btn lvm-prod__btn--off">Uitverkocht</span>
          {%- elsif p.has_only_default_variant -%}
            <form action="{{ routes.cart_add_url }}" method="post" class="lvm-prod__form" data-lvm-add>
              <input type="hidden" name="id" value="{{ v.id }}">
              <input type="hidden" name="quantity" value="1">
              <button type="submit" class="lvm-prod__btn">{{ section.settings.add_label | escape }}</button>
            </form>
          {%- else -%}
            <a class="lvm-prod__btn" href="{{ p.url }}">{{ block.settings.options_label | default: section.settings.options_label | escape }}</a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
    <button type="button" class="lvm-prod__arrow lvm-prod__arrow--prev" data-lvm-prev aria-label="Vorige">
      <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path d="M13 8H3m4-4L3 8l4 4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
    </button>
    <button type="button" class="lvm-prod__arrow lvm-prod__arrow--next" data-lvm-next aria-label="Volgende">
      <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
    </button>
  </div>
</section>

{% style %}
  .lvm-prod-{{ sid }} { background: {{ section.settings.background }}; color: #1f1f1f; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
  .lvm-prod-{{ sid }} .lvm-prod__head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding: 0 20px 24px; max-width: 1400px; margin: 0 auto; }
  .lvm-prod-{{ sid }} .lvm-prod__h { margin: 0; font-family: var(--font-body--family); font-weight: 400; text-transform: uppercase;
    font-size: clamp(22px, 5.6vw, 32px); letter-spacing: -.01em; color: #1f1f1f; }
  .lvm-prod-{{ sid }} .lvm-prod__all { flex: none; font-family: var(--font-body--family); font-size: 15px; text-transform: uppercase; color: #1f1f1f;
    text-decoration: none; border-bottom: 1.5px solid currentColor; padding-bottom: 3px; }
  .lvm-prod-{{ sid }} .lvm-prod__wrap { position: relative; max-width: 1400px; margin: 0 auto; }
  .lvm-prod-{{ sid }} .lvm-prod__track { display: grid; grid-auto-flow: column; grid-auto-columns: 66%; gap: 16px; padding: 0 20px;
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding: 0 20px; scrollbar-width: none; }
  .lvm-prod-{{ sid }} .lvm-prod__track::-webkit-scrollbar { display: none; }
  .lvm-prod-{{ sid }} .lvm-prod__card { scroll-snap-align: start; display: flex; flex-direction: column; }
  .lvm-prod-{{ sid }} .lvm-prod__media { position: relative; display: block; aspect-ratio: 1; background: {{ section.settings.card_bg }}; overflow: hidden; }
  .lvm-prod-{{ sid }} .lvm-prod__media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .6s ease; }
  .lvm-prod-{{ sid }} .lvm-prod__card:hover .lvm-prod__media img { transform: scale(1.03); }
  .lvm-prod-{{ sid }} .lvm-prod__badge { position: absolute; z-index: 1; top: 14px; left: 14px; font-family: var(--font-body--family); font-size: 12px;
    letter-spacing: .03em; text-transform: uppercase; color: #3a3a3a; background: rgb(255 255 255 / 70%); padding: 4px 8px; }
  .lvm-prod-{{ sid }} .lvm-prod__body { flex: 1; padding: 16px 0 12px; }
  .lvm-prod-{{ sid }} .lvm-prod__title { display: block; font-family: var(--font-body--family); font-size: 16px; line-height: 1.35; letter-spacing: .03em;
    text-transform: uppercase; color: #1f1f1f; text-decoration: none; }
  .lvm-prod-{{ sid }} .lvm-prod__price { margin: 8px 0 0; font-family: var(--font-body--family); font-size: 16px; color: #1f1f1f; }
  .lvm-prod-{{ sid }} .lvm-prod__price s { margin-left: 10px; color: #b3261e; }
  .lvm-prod-{{ sid }} .lvm-prod__save { display: inline-block; margin-top: 10px; padding: 3px 8px; border-radius: 3px; background: #b3261e; color: #fff;
    font-family: var(--font-body--family); font-size: 14px; text-transform: uppercase; }
  .lvm-prod-{{ sid }} .lvm-prod__form { margin: 0; }
  .lvm-prod-{{ sid }} .lvm-prod__btn { appearance: none; border: 0; cursor: pointer; display: flex; align-items: center; justify-content: center; width: 100%;
    min-height: 52px; padding: 0 16px; border-radius: 4px; background: #1f1f1f; color: #fff; font-family: var(--font-body--family); font-size: 15px;
    letter-spacing: .04em; text-transform: uppercase; text-decoration: none; transition: background .2s; }
  .lvm-prod-{{ sid }} .lvm-prod__btn:hover { background: #3a3a3a; }
  .lvm-prod-{{ sid }} .lvm-prod__btn[disabled], .lvm-prod-{{ sid }} .lvm-prod__btn--off { opacity: .6; cursor: default; }
  .lvm-prod-{{ sid }} .lvm-prod__arrow { position: absolute; top: calc((100vw - 40px) * .33 - 22px); width: 44px; height: 44px; border-radius: 50%; border: 0;
    background: #fff; color: #1f1f1f; box-shadow: 0 4px 16px -6px rgb(0 0 0 / 25%); display: flex; align-items: center; justify-content: center; cursor: pointer; z-index: 2; }
  .lvm-prod-{{ sid }} .lvm-prod__arrow[disabled] { opacity: 0; pointer-events: none; }
  .lvm-prod-{{ sid }} .lvm-prod__arrow--prev { left: 8px; }
  .lvm-prod-{{ sid }} .lvm-prod__arrow--next { right: 8px; }
  @media (min-width: 900px) {
    .lvm-prod-{{ sid }} .lvm-prod__head, .lvm-prod-{{ sid }} .lvm-prod__track { padding-left: 40px; padding-right: 40px; }
    .lvm-prod-{{ sid }} .lvm-prod__track { grid-auto-columns: calc((100% - 80px - 3 * 16px) / 4); scroll-padding: 0 40px; }
    .lvm-prod-{{ sid }} .lvm-prod__arrow { top: calc((min(100vw, 1400px) - 128px) / 8 - 22px); }
    .lvm-prod-{{ sid }} .lvm-prod__arrow--prev { left: 16px; }
    .lvm-prod-{{ sid }} .lvm-prod__arrow--next { right: 16px; }
  }
{% endstyle %}

{% render 'lovaire-m-slider-js' %}

<script type="module">
  import { CartAddEvent } from '@theme/events';
  if (!window.lovaireMAdd) {
    window.lovaireMAdd = true;
    document.addEventListener('submit', async (event) => {
      const form = event.target instanceof HTMLFormElement && event.target.matches('[data-lvm-add]') ? event.target : null;
      if (!form) return;
      event.preventDefault();
      const button = form.querySelector('button');
      const label = button.textContent;
      button.disabled = true;
      const sections = [...document.querySelectorAll('cart-items-component')].map((el) => el.dataset.sectionId).filter(Boolean);
      const root = window.Shopify?.routes?.root || '/';
      try {
        const response = await fetch(`${root}cart/add.js`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            items: [{ id: Number(form.elements.id.value), quantity: 1 }],
            sections: sections.join(','),
            sections_url: window.location.pathname,
          }),
        });
        const data = await response.json();
        if (!response.ok || data.status) throw new Error(data.description || 'Toevoegen mislukt');
        const cart = await (await fetch(`${root}cart.js`)).json();
        document.dispatchEvent(new CartAddEvent(cart, 'lovaire-m-products', {
          source: 'lovaire-m-products', itemCount: cart.item_count, variantId: form.elements.id.value, sections: data.sections,
        }));
        button.textContent = '✓ Toegevoegd';
        setTimeout(() => { button.textContent = label; button.disabled = false; }, 1800);
      } catch (error) {
        console.error(error);
        form.submit();
      }
    });
  }
</script>

{% schema %}
{
  "name": "Lovaire producten",
  "settings": [
    { "type": "text", "id": "heading", "label": "Kop", "default": "Onze favorieten" },
    { "type": "text", "id": "link_label", "label": "Linktekst", "default": "Bekijk alles" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "add_label", "label": "Knoptekst (direct toevoegen)", "default": "In winkelwagen" },
    { "type": "text", "id": "options_label", "label": "Knoptekst (met opties)", "default": "Kies je tint" },
    { "type": "color", "id": "background", "label": "Achtergrond", "default": "#f8f6f3" },
    { "type": "color", "id": "card_bg", "label": "Achtergrond foto", "default": "#f3ede6" },
    { "type": "range", "id": "padding_top", "label": "Ruimte boven", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Ruimte onder", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "badge", "label": "Label linksboven", "info": "Bijv. BESTSELLER of NIEUW. Leeg = geen label." },
        { "type": "image_picker", "id": "image", "label": "Andere foto (optioneel)" },
        { "type": "text", "id": "options_label", "label": "Knoptekst bij opties (optioneel)" }
      ]
    }
  ],
  "presets": [{ "name": "Lovaire producten", "blocks": [{ "type": "product" }, { "type": "product" }, { "type": "product" }] }]
}
{% endschema %}
