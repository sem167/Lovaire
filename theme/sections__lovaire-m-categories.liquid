{%- comment -%}
  "Shop per categorie" in Meroda-stijl: grote foto's die je opzij schuift, met een cursieve naam eronder
  en een teller (1/3) met pijltjes.
{%- endcomment -%}
{%- assign sid = section.id | replace: '_', '' | downcase -%}
<section class="lvm-cat-{{ sid }}" data-lvm-slider>
  <div class="lvm-cat__head">
    {%- if section.settings.heading != blank -%}<h2 class="lvm-cat__h">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    {%- if section.settings.link_label != blank -%}
      <a class="lvm-cat__all" href="{{ section.settings.link | default: routes.collections_url }}">{{ section.settings.link_label | escape }}</a>
    {%- endif -%}
  </div>

  <div class="lvm-cat__track" data-lvm-track>
    {%- for block in section.blocks -%}
      <a class="lvm-cat__slide" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
        <div class="lvm-cat__media">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 33vw, 86vw', widths: '500, 750, 1000', alt: block.settings.label }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag }}
          {%- endif -%}
        </div>
        <p class="lvm-cat__label">{{ block.settings.label | escape }}</p>
      </a>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="lvm-cat__nav">
      <button type="button" class="lvm-cat__arrow" data-lvm-prev aria-label="Vorige">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M10 3L5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
      </button>
      <span class="lvm-cat__count"><span data-lvm-current>1</span>/{{ section.blocks.size }}</span>
      <button type="button" class="lvm-cat__arrow" data-lvm-next aria-label="Volgende">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
      </button>
    </div>
  {%- endif -%}
</section>

{% style %}
  .lvm-cat-{{ sid }} { background: {{ section.settings.background }}; color: #1f1f1f; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
  .lvm-cat-{{ sid }} .lvm-cat__head { text-align: center; padding: 0 20px 28px; }
  .lvm-cat-{{ sid }} .lvm-cat__h { margin: 0; font-family: var(--font-body--family); font-weight: 400; text-transform: uppercase;
    font-size: clamp(24px, 6.4vw, 36px); letter-spacing: -.01em; line-height: 1.1; color: #1f1f1f; }
  .lvm-cat-{{ sid }} .lvm-cat__all { display: inline-block; margin-top: 10px; font-family: var(--font-body--family); font-size: 15px;
    text-transform: uppercase; color: #3a3a3a; text-decoration: underline; text-underline-offset: 5px; }
  .lvm-cat-{{ sid }} .lvm-cat__track { display: grid; grid-auto-flow: column; grid-auto-columns: 86%; gap: 14px; padding: 0 20px;
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding: 0 20px; scrollbar-width: none; }
  .lvm-cat-{{ sid }} .lvm-cat__track::-webkit-scrollbar { display: none; }
  .lvm-cat-{{ sid }} .lvm-cat__slide { scroll-snap-align: start; color: inherit; text-decoration: none; }
  .lvm-cat-{{ sid }} .lvm-cat__media { aspect-ratio: 1; overflow: hidden; background: #efe9e2; }
  .lvm-cat-{{ sid }} .lvm-cat__media img, .lvm-cat-{{ sid }} .lvm-cat__media svg { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .6s ease; }
  .lvm-cat-{{ sid }} .lvm-cat__slide:hover img { transform: scale(1.03); }
  .lvm-cat-{{ sid }} .lvm-cat__label { margin: 22px 0 0; text-align: center; font-family: var(--lvm-serif, 'Playfair Display', Georgia, serif);
    font-style: italic; font-size: clamp(34px, 9vw, 48px); line-height: 1.1; }
  .lvm-cat-{{ sid }} .lvm-cat__nav { display: flex; align-items: center; justify-content: center; gap: 28px; margin-top: 18px; font-family: var(--font-body--family); font-size: 15px; }
  .lvm-cat-{{ sid }} .lvm-cat__arrow { appearance: none; border: 0; background: none; padding: 8px; cursor: pointer; color: #1f1f1f; }
  .lvm-cat-{{ sid }} .lvm-cat__arrow[disabled] { opacity: .3; cursor: default; }
  @media (min-width: 900px) {
    .lvm-cat-{{ sid }} .lvm-cat__track { grid-auto-columns: calc((100% - 2 * 14px) / 3); max-width: 1320px; margin: 0 auto; padding: 0 40px; scroll-padding: 0 40px; }
    .lvm-cat-{{ sid }} .lvm-cat__nav { display: none; }
  }
{% endstyle %}

{% render 'lovaire-m-slider-js' %}

{% schema %}
{
  "name": "Lovaire categorieën",
  "settings": [
    { "type": "text", "id": "heading", "label": "Kop", "default": "Shop per categorie" },
    { "type": "text", "id": "link_label", "label": "Linktekst", "default": "Shop alles" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "color", "id": "background", "label": "Achtergrond", "default": "#f8f6f3" },
    { "type": "range", "id": "padding_top", "label": "Ruimte boven", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Ruimte onder", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categorie",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Foto" },
        { "type": "text", "id": "label", "label": "Naam", "default": "Make-up" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Lovaire categorieën", "blocks": [{ "type": "category" }, { "type": "category" }, { "type": "category" }] }]
}
{% endschema %}
