{%- assign sid = section.id | replace: '_', '' | downcase -%}
{% style %}
  .lv-fav-{{ sid }} { background: {{ section.settings.background }}; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
  .lv-fav-{{ sid }} .lv-fav__inner { max-width: 1240px; margin: 0 auto; }
  .lv-fav-{{ sid }} .lv-fav__head { padding: 0 20px; margin-bottom: 28px; }
  .lv-fav-{{ sid }} .lv-fav__eyebrow { font-family: var(--font-body--family); font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: #8b6b4a; margin: 0 0 14px; }
  .lv-fav-{{ sid }} .lv-fav__title { font-family: var(--font-heading--family); font-weight: 400; font-size: clamp(30px, 4vw, 42px); color: #111; margin: 0; letter-spacing: -.01em; }
  .lv-fav-{{ sid }} .lv-fav__tab { display: inline-block; margin-top: 30px; padding-bottom: 12px; border-bottom: 2px solid #b39472; font-family: var(--font-body--family); font-size: 13px; font-weight: 600; letter-spacing: .22em; text-transform: uppercase; color: #111; text-decoration: none; }
  .lv-fav-{{ sid }} .lv-fav__track { display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 0 20px 6px; scrollbar-width: none; }
  .lv-fav-{{ sid }} .lv-fav__track::-webkit-scrollbar { display: none; }
  .lv-fav-{{ sid }} .lv-card { flex: 0 0 78%; scroll-snap-align: start; display: flex; flex-direction: column; }
  @media (min-width: 750px) {
    .lv-fav-{{ sid }} .lv-fav__track { display: grid; grid-template-columns: repeat({{ section.settings.columns }}, minmax(0, 1fr)); gap: 32px 24px; overflow: visible; }
    .lv-fav-{{ sid }} .lv-fav__dots { display: none; }
  }
  .lv-fav-{{ sid }} .lv-card__media { position: relative; display: block; aspect-ratio: 1; background: #fff; overflow: hidden; }
  .lv-fav-{{ sid }} .lv-card__media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .6s ease; }
  .lv-fav-{{ sid }} .lv-card:hover .lv-card__media img { transform: scale(1.04); }
  .lv-fav-{{ sid }} .lv-card__badge { position: absolute; top: 12px; left: 12px; background: #8b6b4a; color: #fff; font-family: var(--font-body--family); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; padding: 6px 10px; }
  .lv-fav-{{ sid }} .lv-card__rating { display: block; margin-top: 16px; font-family: var(--font-body--family); font-size: 12px; color: #5a5a5a; }
  .lv-fav-{{ sid }} .lv-card__rating span { color: #8b6b4a; letter-spacing: 1px; }
  .lv-fav-{{ sid }} .lv-card__title { display: block; font-family: var(--font-heading--family); font-size: 17px; line-height: 1.3; margin: 16px 0 6px; color: #111; text-decoration: none; }
  .lv-fav-{{ sid }} .lv-card__rating + .lv-card__title { margin-top: 6px; }
  .lv-fav-{{ sid }} .lv-card__price { font-family: var(--font-heading--family); font-weight: 600; font-size: 17px; display: flex; gap: 8px; align-items: baseline; margin-bottom: 18px; flex: 1; }
  .lv-fav-{{ sid }} .lv-card__compare { color: #8a8a8a; font-weight: 400; text-decoration: line-through; font-size: 14px; }
  .lv-fav-{{ sid }} .lv-buy-form { margin: 0; }
  .lv-fav-{{ sid }} .lv-buy { display: block; width: 100%; box-sizing: border-box; text-align: center; background: #111; color: #fff; border: 0; cursor: pointer; text-decoration: none; font-family: var(--font-body--family); font-size: 13px; letter-spacing: .22em; text-transform: uppercase; padding: 18px 12px; transition: background .25s; }
  .lv-fav-{{ sid }} .lv-buy:hover { background: #8b6b4a; }
  .lv-fav-{{ sid }} .lv-buy--off { background: #d9d0c8; cursor: default; }
  .lv-fav-{{ sid }} .lv-fav__dots { display: flex; justify-content: center; gap: 8px; margin-top: 26px; }
  .lv-fav-{{ sid }} .lv-fav__dots i { width: 7px; height: 7px; border-radius: 99px; background: #d6c8bc; transition: all .3s; }
  .lv-fav-{{ sid }} .lv-fav__dots i.is-active { width: 24px; background: #111; }
  .lv-fav-{{ sid }} .lv-fav__cta { text-align: center; margin-top: 40px; padding: 0 20px; }
  .lv-fav-{{ sid }} .lv-fav__all { display: inline-block; color: #111; font-family: var(--font-body--family); font-size: 13px; letter-spacing: .2em; text-transform: uppercase; text-decoration: none; border-bottom: 1px solid #111; padding-bottom: 4px; }
{% endstyle %}

<section class="lv-fav-{{ sid }}">
  <div class="lv-fav__inner">
    <div class="lv-fav__head">
      {%- if section.settings.eyebrow != blank -%}<p class="lv-fav__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="lv-fav__title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.tab_label != blank -%}<a class="lv-fav__tab" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.tab_label | escape }}</a>{%- endif -%}
    </div>
    <div class="lv-fav__track" data-lv-track>
      {%- for product in section.settings.products -%}
        <article class="lv-card">
          <a class="lv-card__media" href="{{ product.url }}">
            {%- if product.featured_image -%}
              {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: product.title, sizes: '(min-width: 750px) 30vw, 80vw' }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag }}
            {%- endif -%}
            {%- if product.compare_at_price > product.price -%}<span class="lv-card__badge">Sale</span>{%- endif -%}
          </a>
          {%- assign lx_n = product.metafields.loox.num_reviews.value | default: product.metafields.loox.num_reviews | plus: 0 -%}
          {%- if lx_n > 0 -%}
            {%- assign lx_r = product.metafields.loox.avg_rating.value | default: product.metafields.loox.avg_rating | times: 1.0 | round: 1 -%}
            <span class="lv-card__rating"><span aria-hidden="true">★★★★★</span> {{ lx_r | replace: '.', ',' }} ({{ lx_n }})</span>
          {%- endif -%}
          <a class="lv-card__title" href="{{ product.url }}">{{ product.title | escape }}</a>
          <div class="lv-card__price">
            <span>{% if product.price_varies %}Vanaf {% endif %}{{ product.price | money }}</span>
            {%- if product.compare_at_price > product.price -%}<span class="lv-card__compare">{{ product.compare_at_price | money }}</span>{%- endif -%}
          </div>
          {%- render 'lovaire-buy', product: product -%}
        </article>
      {%- else -%}
        <p style="padding:0 20px">Kies producten in de thema-editor.</p>
      {%- endfor -%}
    </div>
    {%- if section.settings.products.size > 1 -%}
      <div class="lv-fav__dots" aria-hidden="true">{%- for p in section.settings.products -%}<i{% if forloop.first %} class="is-active"{% endif %}></i>{%- endfor -%}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <div class="lv-fav__cta"><a class="lv-fav__all" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a></div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var root = document.querySelector('.lv-fav-{{ sid }}');
    if (!root) return;
    var track = root.querySelector('[data-lv-track]'), dots = root.querySelectorAll('.lv-fav__dots i');
    if (!track || !dots.length) return;
    track.addEventListener('scroll', function () {
      var cards = track.children, w = cards[0] ? cards[0].getBoundingClientRect().width + 16 : 1;
      var i = Math.min(dots.length - 1, Math.round(track.scrollLeft / w));
      dots.forEach(function (d, n) { d.classList.toggle('is-active', n === i); });
    }, { passive: true });
  })();
</script>

{% schema %}
{
  "name": "Lovaire favorieten",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "ONZE FAVORIETEN" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Shop de favorieten" },
    { "type": "text", "id": "tab_label", "label": "Tab-tekst", "default": "Alle producten" },
    { "type": "product_list", "id": "products", "label": "Producten", "limit": 12 },
    { "type": "range", "id": "columns", "label": "Kolommen (desktop)", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "text", "id": "button_label", "label": "Link onderaan", "default": "Bekijk alles" },
    { "type": "url", "id": "button_link", "label": "Link" },
    { "type": "color", "id": "background", "label": "Achtergrond", "default": "#f6e9e1" },
    { "type": "range", "id": "padding_top", "label": "Ruimte boven", "min": 0, "max": 120, "step": 4, "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Ruimte onder", "min": 0, "max": 120, "step": 4, "default": 72 }
  ],
  "presets": [{ "name": "Lovaire favorieten" }]
}
{% endschema %}
