{
  "sections": {
    "hero": {
      "type": "lovaire-hero",
      "settings": {
        "image": "shopify://shop_images/lovaire-hero-glow.jpg",
        "focal": "center 25%",
        "eyebrow": "Lovaire beauty",
        "title": "<p>Feel beautiful, <em>every day</em></p>",
        "text": "Make-up, skin and hair care you'll actually use. Carefully selected and always shipped for free.",
        "button_label": "Shop now",
        "button_link": "shopify://collections/all",
        "button2_label": "Explore collections",
        "button2_link": "/collections",
        "trust_1": "Free shipping",
        "trust_2": "Secure checkout with iDEAL",
        "trust_3": "Personal service",
        "badge_title": "Always free shipping",
        "badge_text": "With tracking sent to your inbox",
        "seal_text": "LOVAIRE · BEAUTY · ESSENTIALS · ",
        "background": "#f6e7de",
        "height": 85,
        "blend_top": "#ffffff",
        "blend_bottom": "#fdf9f7"
      }
    },
    "faq": {
      "type": "section",
      "name": "Frequently asked questions",
      "blocks": {
        "heading": {
          "type": "text",
          "settings": {
            "text": "<h2>Frequently asked questions</h2>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "center",
            "type_preset": "h2",
            "font": "var(--font-heading--family)",
            "color": "var(--color-foreground-heading)",
            "wrap": "pretty"
          },
          "blocks": {}
        },
        "acc": {
          "type": "accordion",
          "settings": {
            "icon": "plus",
            "dividers": false,
            "type_preset": "h5",
            "inherit_color_scheme": true
          },
          "blocks": {
            "q1": {
              "type": "_accordion-row",
              "settings": {
                "heading": "When will I receive my order?",
                "open_by_default": false,
                "icon": "none"
              },
              "blocks": {
                "q1_t": {
                  "type": "text",
                  "settings": {
                    "text": "<p>As soon as your order ships, you'll receive an email with your tracking link, so you can follow your parcel every step of the way. You'll find all the details in our <a href=\"/pages/verzendbeleid\">shipping policy</a>.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "color": "var(--color-foreground)",
                    "wrap": "pretty"
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "q1_t"
              ]
            },
            "q2": {
              "type": "_accordion-row",
              "settings": {
                "heading": "How much is shipping?",
                "open_by_default": false,
                "icon": "none"
              },
              "blocks": {
                "q2_t": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Nothing: shipping is always free at Lovaire.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "color": "var(--color-foreground)",
                    "wrap": "pretty"
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "q2_t"
              ]
            },
            "q3": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Can I return my order?",
                "open_by_default": false,
                "icon": "none"
              },
              "blocks": {
                "q3_t": {
                  "type": "text",
                  "settings": {
                    "text": "<p>You can return your order within 14 days of receiving it. Separate conditions apply to hygiene products such as cosmetics and underwear. Read everything on our <a href=\"/pages/bestellingen-en-levering-1\">returns and exchanges</a> page.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "color": "var(--color-foreground)",
                    "wrap": "pretty"
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "q3_t"
              ]
            },
            "q4": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Where are your products made?",
                "open_by_default": false,
                "icon": "none"
              },
              "blocks": {
                "q4_t": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Our products are made both locally and around the world. We choose our production partners carefully, so you get quality at a fair price.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "color": "var(--color-foreground)",
                    "wrap": "pretty"
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "q4_t"
              ]
            },
            "q5": {
              "type": "_accordion-row",
              "settings": {
                "heading": "I have a question, how can I reach you?",
                "open_by_default": false,
                "icon": "none"
              },
              "blocks": {
                "q5_t": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Send us a message via our <a href=\"/pages/contact\">contact page</a>. We reply on weekdays between 09:00 and 17:00.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "color": "var(--color-foreground)",
                    "wrap": "pretty"
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "q5_t"
              ]
            }
          },
          "block_order": [
            "q1",
            "q2",
            "q3",
            "q4",
            "q5"
          ]
        }
      },
      "block_order": [
        "heading",
        "acc"
      ],
      "settings": {
        "content_direction": "column",
        "vertical_on_mobile": true,
        "horizontal_alignment_flex_direction_column": "center",
        "vertical_alignment_flex_direction_column": "center",
        "section_width": "page-width",
        "gap": 32,
        "color_scheme": "scheme-1",
        "padding-block-start": 80,
        "padding-block-end": 80
      }
    },
