{
  "sections": {
    "main": {
      "type": "product-information",
      "blocks": {
        "media-gallery": {
          "type": "_product-media-gallery",
          "static": true,
          "settings": {
            "media_presentation": "carousel",
            "media_columns": "one",
            "image_gap": 8,
            "icons_style": "arrow",
            "slideshow_controls_style": "thumbnails",
            "slideshow_mobile_controls_style": "dots",
            "thumbnail_position": "bottom",
            "thumbnail_width": 64,
            "thumbnail_radius": 10,
            "aspect_ratio": "1/1.25",
            "media_fit": "cover",
            "media_radius": 20,
            "zoom": true,
            "hide_variants": false
          },
          "blocks": {}
        },
        "product-details": {
          "type": "_product-details",
          "static": true,
          "settings": {
            "width": "fill",
            "width_mobile": "fill",
            "height": "fit",
            "details_position": "flex-start",
            "gap": 16,
            "sticky_details_desktop": true,
            "inherit_color_scheme": true,
            "padding-block-start": 16,
            "padding-block-end": 16,
            "padding-inline-start": 12,
            "padding-inline-end": 12
          },
          "blocks": {
            "vendor": {
              "type": "text",
              "settings": {
                "text": "<p>LOVAIRE</p>",
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "h6",
                "font": "var(--font-body--family)",
                "color": "var(--color-primary)",
                "wrap": "pretty"
              },
              "blocks": {}
            },
            "title": {
              "type": "text",
              "settings": {
                "text": "<h1>{{ closest.product.title }}</h1>",
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "h2",
                "font": "var(--font-heading--family)",
                "color": "var(--color-foreground-heading)",
                "wrap": "pretty"
              },
              "blocks": {}
            },
            "price": {
              "type": "price",
              "settings": {
                "show_sale_price_first": true,
                "show_installments": true,
                "show_tax_info": true,
                "type_preset": "h4",
                "width": "100%",
                "alignment": "left"
              },
              "blocks": {}
            },
            "variants": {
              "type": "variant-picker",
              "settings": {
                "variant_style": "buttons",
                "show_swatches": true,
                "alignment": "left",
                "padding-block-start": 4,
                "padding-block-end": 4
              },
              "blocks": {}
            },
            "buy": {
              "type": "buy-buttons",
              "settings": {
                "stacking": true,
                "show_pickup_availability": false,
                "gift_card_form": true
              },
              "blocks": {
                "quantity": {
                  "type": "quantity",
                  "static": true,
                  "settings": {},
                  "blocks": {}
                },
                "add-to-cart": {
                  "type": "add-to-cart",
                  "static": true,
                  "settings": {
                    "style_class": "button"
                  },
                  "blocks": {}
                },
                "accelerated-checkout": {
                  "type": "accelerated-checkout",
                  "static": true,
                  "settings": {},
                  "blocks": {}
                }
              },
              "block_order": []
            },
            "payicons": {
              "type": "payment-icons",
              "settings": {
                "horizontal_alignment": "center",
                "gap": 8,
                "padding-block-start": 4,
                "padding-block-end": 4
              },
              "blocks": {}
            },
            "trust": {
              "type": "text",
              "settings": {
                "text": "<p><strong>THE LOVAIRE PROMISE</strong><br/>✓ Always free shipping<br/>✓ Secure checkout with iDEAL or Klarna<br/>✓ Shipped with tracking</p>",
                "width": "100%",
                "alignment": "left",
                "type_preset": "rte",
                "font": "var(--font-body--family)",
                "color": "var(--color-foreground)",
                "wrap": "pretty",
                "background": true,
                "background_color": "#f6e7de",
                "corner_radius": 16,
                "padding-block-start": 16,
                "padding-block-end": 16,
                "padding-inline-start": 18,
                "padding-inline-end": 18
              },
              "blocks": {}
            },
            "description": {
              "type": "product-description",
              "settings": {},
              "blocks": {}
            },
            "info": {
              "type": "accordion",
              "settings": {
                "icon": "plus",
                "dividers": true,
                "type_preset": "h6",
                "inherit_color_scheme": true
              },
              "blocks": {
                "ship": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Shipping & delivery",
                    "open_by_default": false,
                    "icon": "none"
                  },
                  "blocks": {
                    "ship_t": {
                      "type": "text",
                      "settings": {
                        "text": "<p>You'll receive an email with a tracking link as soon as your order is on its way. More info: <a href=\"/pages/verzendbeleid\">shipping policy</a>.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "rte",
                        "font": "var(--font-body--family)",
                        "color": "var(--color-foreground)",
                        "wrap": "pretty"
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "ship_t"
                  ]
                },
                "ret": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Returns",
                    "open_by_default": false,
                    "icon": "none"
                  },
                  "blocks": {
                    "ret_t": {
                      "type": "text",
                      "settings": {
                        "text": "<p>You can return your order within 14 days of receiving it. Separate conditions apply to hygiene products such as cosmetics and underwear: see <a href=\"/pages/ruilen-en-retourneren\">hygiene products</a>. You'll find every step on our <a href=\"/pages/bestellingen-en-levering-1\">returns and exchanges</a> page.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "rte",
                        "font": "var(--font-body--family)",
                        "color": "var(--color-foreground)",
                        "wrap": "pretty"
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "ret_t"
                  ]
                },
                "pay": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Secure payment",
                    "open_by_default": false,
                    "icon": "none"
                  },
                  "blocks": {
                    "pay_t": {
                      "type": "text",
                      "settings": {
                        "text": "<p>You pay through Shopify's secure checkout, with options including iDEAL and Klarna. We never see or store your payment details.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "rte",
                        "font": "var(--font-body--family)",
                        "color": "var(--color-foreground)",
                        "wrap": "pretty"
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "pay_t"
                  ]
                },
                "help": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Questions? We're happy to help",
                    "open_by_default": false,
                    "icon": "none"
                  },
                  "blocks": {
                    "help_t": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Email us via our <a href=\"/pages/contact\">contact page</a>. We reply on weekdays between 09:00 and 17:00.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "rte",
                        "font": "var(--font-body--family)",
                        "color": "var(--color-foreground)",
                        "wrap": "pretty"
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "help_t"
                  ]
                }
              },
              "block_order": [
                "ship",
                "ret",
                "pay",
                "help"
              ]
            },
            "rating": {
              "type": "lovaire-rating",
              "settings": {},
              "blocks": {}
            }
          },
          "block_order": [
            "vendor",
            "title",
            "rating",
            "price",
            "variants",
            "buy",
            "payicons",
            "trust",
            "description",
            "info"
          ]
        }
      },
      "settings": {
        "content_width": "content-center-aligned",
        "desktop_media_position": "left",
        "equal_columns": true,
        "limit_details_width": true,
        "gap": 48,
        "enable_sticky_add_to_cart": true,
        "color_scheme": "scheme-1",
        "padding-block-start": 32,
        "padding-block-end": 48
      }
    },
    "usps": {
      "type": "_blocks",
      "name": "Benefits",
      "blocks": {
        "usp": {
          "type": "ai_gen_block_1e9e953",
          "settings": {
            "desktop_width_percent": 100,
            "background_color": "#ffffff",
            "padding_top": 28,
            "padding_bottom": 28,
            "padding_horizontal": 16,
            "padding_top_mobile": 20,
            "padding_bottom_mobile": 20,
            "padding_horizontal_mobile": 12,
            "section_spacing": 20,
            "show_payment_icons": true,
            "payment_bg_color": "#ffffff",
            "payment_border_color": "#ddd2c3",
            "payment_border_radius": 6,
            "columns_desktop": "3",
            "columns_mobile": "3",
            "show_feature_1": true,
            "feature_1_title": "Free shipping",
            "feature_1_text": "On every order",
            "show_feature_2": true,
            "feature_2_title": "Secure payment",
            "feature_2_text": "iDEAL · Klarna",
            "show_feature_3": true,
            "feature_3_title": "Personal service",
            "feature_3_text": "Mon–Fri 09:00–17:00",
            "icon_size": 28,
            "icon_color": "#8b6b4a",
            "title_font_weight": "700",
            "title_color": "#111111",
            "text_color": "#5a5a5a"
          },
          "blocks": {}
        }
      },
      "block_order": [
        "usp"
      ],
      "settings": {
        "content_direction": "column",
        "vertical_on_mobile": true,
        "horizontal_alignment_flex_direction_column": "center",
        "vertical_alignment_flex_direction_column": "center",
        "section_width": "page-width",
        "color_scheme": "scheme-1",
        "padding-block-start": 0,
        "padding-block-end": 24
      }
    },
    "recommendations": {
      "type": "product-recommendations",
      "name": "Recommended",
      "blocks": {
        "heading": {
          "type": "text",
          "settings": {
            "text": "<h2>You may also like</h2>",
            "width": "fit-content",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "h2",
            "font": "var(--font-heading--family)",
            "color": "var(--color-foreground-heading)",
            "wrap": "pretty"
          },
          "blocks": {}
        },
        "static-product-card": {
          "type": "_product-card",
          "static": true,
          "settings": {
            "product_card_gap": 12,
            "inherit_color_scheme": true
