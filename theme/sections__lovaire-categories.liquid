{%- assign sid = section.id | replace: '_', '' | downcase -%}
{% style %}
  .lvc-{{ sid }} { background: {{ section.settings.background }}; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
  .lvc-{{ sid }} .lvc__head { text-align: center; margin: 0 auto 32px; padding: 0 20px; }
  .lvc-{{ sid }} .lvc__eyebrow { font-family: var(--font-body--family); font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: #8b6b4a; margin: 0 0 12px; }
  .lvc-{{ sid }} .lvc__title { font-family: var(--font-heading--family); font-weight: 400; font-size: clamp(28px, 4vw, 40px); color: #111; margin: 0; letter-spacing: -.01em; }
  .lvc-{{ sid }} .lvc__row { display: flex; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 4px 16px 8px; scrollbar-width: none; justify-content: flex-start; }
  .lvc-{{ sid }} .lvc__row::-webkit-scrollbar { display: none; }
  @media (min-width: 750px) { .lvc-{{ sid }} .lvc__row { justify-content: center; gap: 32px; overflow: visible; } }
  .lvc-{{ sid }} .lvc__item { flex: 0 0 23%; min-width: 86px; max-width: 170px; scroll-snap-align: start; text-align: center; text-decoration: none; color: #111; }
  @media (min-width: 750px) { .lvc-{{ sid }} .lvc__item { flex: 0 0 160px; } }
  .lvc-{{ sid }} .lvc__ring { position: relative; aspect-ratio: 1; border-radius: 50%; padding: 7px; border: 1.5px dashed #cdb8a6; transition: transform .4s ease, border-color .4s ease; }
  .lvc-{{ sid }} .lvc__item:hover .lvc__ring { transform: rotate(8deg); border-color: #8b6b4a; }
  .lvc-{{ sid }} .lvc__img { width: 100%; height: 100%; border-radius: 50%; overflow: hidden; background: #f6e7de; }
  .lvc-{{ sid }} .lvc__img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s ease; }
  .lvc-{{ sid }} .lvc__item:hover .lvc__img img { transform: scale(1.06); }
  .lvc-{{ sid }} .lvc__name { display: block; margin-top: 12px; font-family: var(--font-heading--family); font-weight: 500; font-size: 15px; line-height: 1.25; }
{% endstyle %}

<section class="lvc-{{ sid }}">
  <div class="lvc__head">
    {%- if section.settings.eyebrow != blank -%}<p class="lvc__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="lvc__title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  </div>
  <div class="lvc__row">
    {%- for c in section.settings.collections -%}
      <a class="lvc__item" href="{{ c.url }}">
        <div class="lvc__ring"><div class="lvc__img">
          {%- assign img = c.featured_image | default: c.products.first.featured_image -%}
          {%- if img -%}{{ img | image_url: width: 400 | image_tag: loading: 'lazy', alt: c.title }}{%- else -%}{{ 'collection-1' | placeholder_svg_tag }}{%- endif -%}
        </div></div>
        <span class="lvc__name">{{ c.title | escape }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Lovaire categorieën",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "ONTDEK" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Waar ben je naar op zoek?" },
    { "type": "collection_list", "id": "collections", "label": "Collecties", "limit": 8 },
    { "type": "color", "id": "background", "label": "Achtergrond", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "label": "Ruimte boven", "min": 0, "max": 120, "step": 4, "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Ruimte onder", "min": 0, "max": 120, "step": 4, "default": 64 }
  ],
  "presets": [{ "name": "Lovaire categorieën" }]
}
{% endschema %}
