{
  "sections": {
    "header": {
      "type": "section",
      "name": "Collection header",
      "blocks": {
        "eyebrow": {
          "type": "text",
          "settings": {
            "text": "<p>LOVAIRE COLLECTION</p>",
            "width": "fit-content",
            "max_width": "normal",
            "alignment": "center",
            "type_preset": "h6",
            "font": "var(--font-body--family)",
            "color": "var(--color-primary)",
            "wrap": "pretty"
          },
          "blocks": {}
        },
        "title": {
          "type": "text",
          "settings": {
            "text": "<h1>{{ closest.collection.title }}</h1>",
            "width": "fit-content",
            "max_width": "normal",
            "alignment": "center",
            "type_preset": "h1",
            "font": "var(--font-heading--family)",
            "color": "var(--color-foreground-heading)",
            "wrap": "pretty"
          },
          "blocks": {}
        },
        "desc": {
          "type": "text",
          "settings": {
            "text": "{{ closest.collection.description }}",
            "width": "fit-content",
            "max_width": "narrow",
            "alignment": "center",
            "type_preset": "rte",
            "font": "var(--font-body--family)",
            "color": "var(--color-foreground)",
            "wrap": "pretty"
          },
          "blocks": {}
        }
      },
      "block_order": [
        "eyebrow",
        "title",
        "desc"
      ],
      "settings": {
        "content_direction": "column",
        "vertical_on_mobile": true,
        "horizontal_alignment_flex_direction_column": "center",
        "vertical_alignment_flex_direction_column": "center",
        "section_width": "page-width",
        "gap": 12,
        "color_scheme": "scheme-5",
        "padding-block-start": 48,
        "padding-block-end": 8
      }
    },
    "main": {
      "type": "main-collection",
      "blocks": {
        "filters": {
          "type": "filters",
          "static": true,
          "settings": {
            "enable_filtering": true,
            "filter_style": "horizontal",
            "filter_width": "centered",
            "enable_sorting": true,
            "enable_grid_density": true,
            "inherit_color_scheme": true
          },
          "blocks": {}
        },
        "product-card": {
          "type": "_product-card",
          "static": true,
          "settings": {
            "product_card_gap": 10,
            "inherit_color_scheme": true
          },
          "blocks": {
            "card-gallery": {
              "type": "_product-card-gallery",
              "settings": {
                "image_ratio": "square",
                "border_radius": 0
              },
              "blocks": {}
            },
            "group": {
              "type": "_product-card-group",
              "settings": {
                "content_direction": "column",
                "gap": 4,
                "horizontal_alignment_flex_direction_column": "flex-start",
                "width": "fill",
                "width_mobile": "fill",
                "inherit_color_scheme": true
              },
              "blocks": {
                "title": {
                  "type": "product-title",
                  "settings": {
                    "type_preset": "h5",
                    "alignment": "left",
                    "color": "var(--color-foreground-heading)"
                  },
                  "blocks": {}
                },
                "price": {
                  "type": "price",
                  "settings": {
                    "show_sale_price_first": true,
                    "type_preset": "paragraph",
                    "width": "100%",
                    "alignment": "left"
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "title",
                "price"
              ]
            }
          },
          "block_order": [
            "card-gallery",
            "group"
          ]
        }
      },
      "settings": {
        "layout_type": "grid",
        "product_card_size": "medium",
        "mobile_product_card_size": "small",
        "product_grid_width": "centered",
        "full_width_on_mobile": false,
        "columns_gap_horizontal": 20,
        "columns_gap_vertical": 32,
        "color_scheme": "scheme-1",
        "padding-block-start": 32,
        "padding-block-end": 56
      }
    },
    "nav": {
      "type": "lovaire-categories",
      "settings": {
        "eyebrow": "",
        "heading": "",
        "collections": [
          "make-up",
          "huid-producten",
          "haarverzorging",
          "beauty-tools",
          "shapewear"
        ],
        "background": "#f6e7de",
        "padding_top": 16,
        "padding_bottom": 40,
        "blend_bottom": "#ffffff"
      }
    },
    "belofte": {
      "type": "lovaire-belofte",
      "blocks": {
        "b1": {
          "type": "item",
          "settings": {
            "icon": "truck",
            "title": "Free shipping",
            "text": "On every order, no minimum spend."
          }
        },
        "b2": {
          "type": "item",
          "settings": {
            "icon": "lock",
            "title": "Secure payment",
            "text": "iDEAL, Klarna and more via a secure checkout."
          }
        },
        "b3": {
          "type": "item",
          "settings": {
            "icon": "package",
            "title": "Order tracking",
            "text": "Follow your parcel from the moment it ships."
          }
        },
        "b4": {
          "type": "item",
          "settings": {
            "icon": "chat",
            "title": "Personal service",
            "text": "We're here for you Mon–Fri, 09:00–17:00."
          }
        }
      },
      "block_order": [
        "b1",
        "b2",
        "b3",
        "b4"
      ],
      "settings": {
        "eyebrow": "",
        "heading": "",
        "show_payment": true,
        "background": "#ffffff",
        "padding_top": 0,
        "padding_bottom": 40,
        "layout": "list",
        "blend_bottom": "#f6e7de"
      }
    },
    "fade_0": {
      "type": "lovaire-fade",
      "settings": {
        "from": "#ffffff",
        "to": "#f6e7de",
        "height": 70
      }
    }
  },
  "order": [
    "fade_0",
    "header",
    "nav",
    "main",
    "belofte"
  ]
}