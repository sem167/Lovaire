{
  "sections": {
    "main": {
      "type": "product-information",
      "blocks": {
        "media-gallery": {
          "type": "_product-media-gallery",
          "static": true,
          "settings": {
            "media_presentation": "carousel",
            "media_columns": "one",
            "image_gap": 8,
            "icons_style": "arrow",
            "slideshow_controls_style": "thumbnails",
            "slideshow_mobile_controls_style": "dots",
            "thumbnail_position": "bottom",
            "thumbnail_width": 64,
            "thumbnail_radius": 10,
            "aspect_ratio": "1/1.25",
            "media_fit": "cover",
            "media_radius": 20,
            "zoom": true,
            "hide_variants": false
          },
          "blocks": {}
        },
        "product-details": {
          "type": "_product-details",
          "static": true,
          "settings": {
            "width": "fill",
            "width_mobile": "fill",
            "height": "fit",
            "details_position": "flex-start",
            "gap": 18,
            "sticky_details_desktop": true,
            "inherit_color_scheme": true,
            "padding-block-start": 16,
            "padding-block-end": 16,
            "padding-inline-start": 12,
            "padding-inline-end": 12
          },
          "blocks": {
            "title": {
              "type": "text",
              "settings": {
                "text": "<h1>{{ closest.product.title }}</h1>",
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "h2",
                "font": "var(--font-heading--family)",
                "color": "var(--color-foreground-heading)",
                "wrap": "pretty"
              },
              "blocks": {}
            },
            "price": {
              "type": "price",
              "settings": {
                "show_sale_price_first": true,
                "show_installments": true,
                "show_tax_info": true,
                "type_preset": "h4",
                "width": "100%",
                "alignment": "left"
              },
              "blocks": {}
            },
            "variants": {
              "type": "variant-picker",
              "settings": {
                "variant_style": "buttons",
                "show_swatches": true,
                "alignment": "left",
                "padding-block-start": 4,
                "padding-block-end": 4
              },
              "blocks": {}
            },
            "buy": {
              "type": "buy-buttons",
              "settings": {
                "stacking": true,
                "show_pickup_availability": false,
                "gift_card_form": true
              },
              "blocks": {
                "quantity": {
                  "type": "quantity",
                  "static": true,
                  "settings": {},
                  "blocks": {}
                },
                "add-to-cart": {
                  "type": "add-to-cart",
                  "static": true,
                  "settings": {
                    "style_class": "button"
                  },
                  "blocks": {}
                },
                "accelerated-checkout": {
                  "type": "accelerated-checkout",
                  "static": true,
                  "settings": {},
                  "blocks": {}
                }
              },
              "block_order": []
            },
            "description": {
              "type": "product-description",
              "settings": {},
              "blocks": {}
            },
            "info": {
              "type": "accordion",
              "settings": {
                "icon": "plus",
                "dividers": true,
                "type_preset": "h6",
                "inherit_color_scheme": true
              },
              "blocks": {
                "ship": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Verzending & levering",
                    "open_by_default": false,
                    "icon": "none"
                  },
                  "blocks": {
                    "ship_t": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Je ontvangt een e-mail met een track-and-trace-link zodra je bestelling onderweg is. Meer info: <a href=\"/pages/verzendbeleid\">verzendbeleid</a>.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "rte",
                        "font": "var(--font-body--family)",
                        "color": "var(--color-foreground)",
                        "wrap": "pretty"
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "ship_t"
                  ]
                },
                "ret": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Retourneren",
                    "open_by_default": false,
                    "icon": "none"
                  },
                  "blocks": {
                    "ret_t": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Je kunt je bestelling binnen 14 dagen na ontvangst retourneren. Voor hygiëneproducten zoals cosmetica en ondergoed gelden aparte voorwaarden: zie <a href=\"/pages/ruilen-en-retourneren\">hygiëneproducten</a>. Alle stappen vind je op onze pagina <a href=\"/pages/bestellingen-en-levering-1\">ruilen en retourneren</a>.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "rte",
                        "font": "var(--font-body--family)",
                        "color": "var(--color-foreground)",
                        "wrap": "pretty"
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "ret_t"
                  ]
                },
                "pay": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Veilig betalen",
                    "open_by_default": false,
                    "icon": "none"
                  },
                  "blocks": {
                    "pay_t": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Je betaalt via de beveiligde checkout van Shopify, onder andere met iDEAL en Klarna. Wij zien of bewaren je betaalgegevens nooit.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "rte",
                        "font": "var(--font-body--family)",
                        "color": "var(--color-foreground)",
                        "wrap": "pretty"
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "pay_t"
                  ]
                },
                "help": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Vragen? We helpen je graag",
                    "open_by_default": false,
                    "icon": "none"
                  },
                  "blocks": {
                    "help_t": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Mail ons via onze <a href=\"/pages/contact\">contactpagina</a>. We reageren op werkdagen tussen 09:00 en 17:00.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "rte",
                        "font": "var(--font-body--family)",
                        "color": "var(--color-foreground)",
                        "wrap": "pretty"
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "help_t"
                  ]
                }
              },
              "block_order": [
                "ship",
                "ret",
                "pay",
                "help"
              ]
            },
            "lovaire_trust": {
              "type": "lovaire-product-trust",
              "settings": {},
              "blocks": {}
            },
            "lyvelle_intro": {
              "type": "lovaire-pdp-intro",
              "settings": {
                "subtitle": "Camoufleert donkere kringen direct – voor een frissere, uitgeruste blik",
                "pill_1_emoji": "🇰🇷",
                "pill_1_text": "Het K-beauty geheim voor stralende ogen",
                "pill_2_emoji": "👁️",
                "pill_2_text": "Oogcrème én concealer in één",
                "pill_3_emoji": "💧",
                "pill_3_text": "Verzorgt met calcium, niacinamide & collageen",
                "restyle_section": true,
                "button_color": "#6ab04c",
                "button_hover_color": "#5c9d40"
              },
              "blocks": {}
            }
          },
          "block_order": [
            "title",
            "lyvelle_intro",
            "price",
            "variants",
            "buy",
            "lovaire_trust",
            "description",
            "info"
          ]
        }
      },
      "settings": {
        "content_width": "content-center-aligned",
        "desktop_media_position": "left",
        "equal_columns": true,
        "limit_details_width": true,
        "gap": 48,
        "enable_sticky_add_to_cart": false,
        "color_scheme": "scheme-1",
        "padding-block-start": 32,
        "padding-block-end": 48
