{%- comment -%}
  Twee staande video's naast elkaar (ook op mobiel) met een vette kop erboven, zoals op Lyvelle.
  Video's kies je in de thema-editor uit Inhoud → Bestanden. Zonder video's wordt de sectie niet getoond.
{%- endcomment -%}
{%- liquid
  assign v1 = section.settings.video_1
  assign v2 = section.settings.video_2
  assign u1 = section.settings.video_1_url
  assign u2 = section.settings.video_2_url
  assign has_video = false
  if v1 != blank or v2 != blank or u1 != blank or u2 != blank
    assign has_video = true
  endif
-%}
{%- if has_video or request.design_mode -%}
  <div class="lvd-{{ section.id }}">
    {%- if section.settings.heading != blank -%}
      <h2 class="lvd__h">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <div class="lvd__grid">
      {%- for v in (1..2) -%}
        {%- if v == 1 -%}{%- assign vid = v1 -%}{%- assign vurl = u1 -%}{%- else -%}{%- assign vid = v2 -%}{%- assign vurl = u2 -%}{%- endif -%}
        <div class="lvd__item">
          {%- if vurl != blank -%}
            <video class="lvd__video" src="{{ vurl | escape }}" autoplay muted loop playsinline preload="metadata"></video>
          {%- elsif vid != blank -%}
            {{ vid | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata', image_size: '720x', class: 'lvd__video' }}
          {%- else -%}
            <div class="lvd__empty">Kies video {{ v }} in de thema-editor</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>

  {% style %}
    .lvd-{{ section.id }} { background: {{ section.settings.background }};
      padding: {{ section.settings.padding_top }}px 12px {{ section.settings.padding_bottom }}px; }
    .lvd-{{ section.id }} .lvd__h { max-width: 760px; margin: 0 auto 24px; text-align: center; color: #111;
      font-family: var(--font-body--family); font-weight: 700; font-size: clamp(26px, 6.4vw, 40px); line-height: 1.18; }
    .lvd-{{ section.id }} .lvd__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; max-width: 760px; margin: 0 auto; }
    .lvd-{{ section.id }} .lvd__item { aspect-ratio: 9 / 16; overflow: hidden; background: #f3ece6; }
    .lvd-{{ section.id }} .lvd__item video, .lvd-{{ section.id }} .lvd__item img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .lvd-{{ section.id }} .lvd__empty { height: 100%; display: grid; place-items: center; padding: 16px; text-align: center;
      font-size: 13px; color: #8a8a8a; border: 1px dashed #d8c8b4; }
  {% endstyle %}
{%- endif -%}

{% schema %}
{
  "name": "Lovaire video's",
  "settings": [
    { "type": "text", "id": "heading", "label": "Kop", "default": "Zie hem zelf in actie 💕" },
    { "type": "video", "id": "video_1", "label": "Video 1 (staand, 9:16)" },
    { "type": "video", "id": "video_2", "label": "Video 2 (staand, 9:16)" },
    { "type": "url", "id": "video_1_url", "label": "Video 1 – directe link (optioneel)", "info": "Gaat voor 'Video 1'. Gebruik alleen als de gekozen video niet afspeelt." },
    { "type": "url", "id": "video_2_url", "label": "Video 2 – directe link (optioneel)" },
    { "type": "color", "id": "background", "label": "Achtergrond", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "label": "Ruimte boven", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Ruimte onder", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [{ "name": "Lovaire video's" }]
}
{% endschema %}
