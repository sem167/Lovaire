{%- liquid
  assign sid = section.id | replace: '_', '' | downcase
  assign p = closest.product
  assign raw = p.metafields.lovaire.benefits.value | default: ''
  assign lines = raw | newline_to_br | split: '<br />'
  assign img = p.images.last | default: p.featured_image
-%}
{%- assign rawlen = raw | strip | size -%}
{%- if rawlen > 0 -%}
{% style %}
  .lpb-{{ sid }} { background: {% render 'lovaire-bg', bg: section.settings.background, top: section.settings.blend_top, bottom: section.settings.blend_bottom %}; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
  .lpb-{{ sid }} .lpb__inner { max-width: 1100px; margin: 0 auto; padding: 0 20px; display: grid; gap: 32px; align-items: center; }
  @media (min-width: 800px) { .lpb-{{ sid }} .lpb__inner { grid-template-columns: 5fr 6fr; gap: 72px; } }
  .lpb-{{ sid }} .lpb__media { position: relative; aspect-ratio: 1; border-radius: 50%; overflow: hidden; background: #efe4d9; width: 78%; max-width: 420px; justify-self: center; box-shadow: 0 0 0 10px #fff, 0 0 0 11px #e6d6c6; }
  .lpb-{{ sid }} .lpb__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .lpb-{{ sid }} .lpb__eyebrow { font-family: var(--font-body--family); font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: #8b6b4a; margin: 0 0 12px; }
  .lpb-{{ sid }} .lpb__title { font-family: var(--font-heading--family); font-weight: 400; font-size: clamp(28px, 4vw, 40px); line-height: 1.12; color: #111; margin: 0 0 24px; }
  .lpb-{{ sid }} .lpb__title em { font-style: italic; color: #8b6b4a; }
  .lpb-{{ sid }} .lpb__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .lpb-{{ sid }} .lpb__list li { display: flex; align-items: center; gap: 14px; padding: 14px 16px; background: #fff; border-radius: 14px; font-family: var(--font-body--family); font-size: 15px; color: #222; line-height: 1.4; }
  .lpb-{{ sid }} .lpb__check { flex: none; width: 26px; height: 26px; border-radius: 50%; background: #111; color: #fff; display: grid; place-items: center; }
  .lpb-{{ sid }} .lpb__check svg { width: 13px; height: 13px; }
  @media (max-width: 799px) { .lpb-{{ sid }} .lpb__text { text-align: center; } .lpb-{{ sid }} .lpb__list li { text-align: left; } }
{% endstyle %}
<section class="lpb-{{ sid }}">
  <div class="lpb__inner">
    <div class="lpb__media">{%- if img -%}{{ img | image_url: width: 900 | image_tag: loading: 'lazy', alt: p.title, sizes: '(min-width: 800px) 420px, 78vw' }}{%- endif -%}</div>
    <div class="lpb__text">
      {%- if section.settings.eyebrow != blank -%}<p class="lpb__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="lpb__title">{{ section.settings.heading | escape }} <em>{{ section.settings.heading_italic | escape }}</em></h2>
      <ul class="lpb__list" role="list">
        {%- for line in lines -%}
          {%- assign l = line | strip -%}
          {%- assign llen = l | size -%}
          {%- if llen > 0 -%}
            <li><span class="lpb__check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>{{ l | escape }}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Lovaire voordelen product",
  "settings": [
    { "type": "paragraph", "content": "Voordelen komen uit het product-metaveld lovaire.benefits (één per regel). Foto: de laatste productfoto." },
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "THE ESSENTIALS" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Everything it" },
    { "type": "text", "id": "heading_italic", "label": "Kop – cursief", "default": "does for you" },
    { "type": "color", "id": "blend_top", "label": "Overloop boven (automatisch)" },
    { "type": "color", "id": "blend_bottom", "label": "Overloop onder (automatisch)" },
    { "type": "color", "id": "background", "label": "Achtergrond", "default": "#f8f1ec" },
    { "type": "range", "id": "padding_top", "label": "Ruimte boven", "min": 0, "max": 120, "step": 4, "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Ruimte onder", "min": 0, "max": 120, "step": 4, "default": 72 }
  ],
  "presets": [{ "name": "Lovaire voordelen product" }]
}
{% endschema %}
