{%- comment -%}
  "Community love"-blok zonder reviews: een rij foto's van de producten in gebruik, elk met een link naar het product.
  Bewust geen verzonnen reviews of sterren.
{%- endcomment -%}
{%- assign sid = section.id | replace: '_', '' | downcase -%}
<section class="lvm-gal-{{ sid }}">
  <div class="lvm-gal__head">
    {%- if section.settings.heading != blank -%}<h2 class="lvm-gal__h">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    {%- if section.settings.subheading != blank -%}<p class="lvm-gal__sub">{{ section.settings.subheading | escape }}</p>{%- endif -%}
  </div>
  <div class="lvm-gal__track">
    {%- for block in section.blocks -%}
      {%- assign p = block.settings.product -%}
      <a class="lvm-gal__item" href="{% if p != blank %}{{ p.url }}{% else %}#{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 25vw, 60vw', widths: '350, 500, 700', alt: block.settings.caption }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {%- endif -%}
        {%- if block.settings.caption != blank or p != blank -%}
          <span class="lvm-gal__caption">{{ block.settings.caption | default: p.title | escape }}</span>
        {%- endif -%}
      </a>
    {%- endfor -%}
  </div>
</section>

{% style %}
  .lvm-gal-{{ sid }} { background: {{ section.settings.background }}; color: #1f1f1f; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
  .lvm-gal-{{ sid }} .lvm-gal__head { text-align: center; padding: 0 20px 26px; }
  .lvm-gal-{{ sid }} .lvm-gal__h { margin: 0; font-family: var(--font-body--family); font-weight: 400; text-transform: uppercase;
    font-size: clamp(24px, 6.4vw, 34px); letter-spacing: -.01em; color: #1f1f1f; }
  .lvm-gal-{{ sid }} .lvm-gal__sub { margin: 6px 0 0; font-family: var(--lvm-serif, 'Playfair Display', Georgia, serif); font-style: italic; font-size: 20px; color: #5a5a5a; }
  .lvm-gal-{{ sid }} .lvm-gal__track { display: grid; grid-auto-flow: column; grid-auto-columns: 60%; gap: 10px; padding: 0 20px;
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding: 0 20px; scrollbar-width: none; }
  .lvm-gal-{{ sid }} .lvm-gal__track::-webkit-scrollbar { display: none; }
  .lvm-gal-{{ sid }} .lvm-gal__item { position: relative; scroll-snap-align: start; display: block; aspect-ratio: 4 / 5; overflow: hidden; background: #efe9e2; color: #fff; text-decoration: none; }
  .lvm-gal-{{ sid }} .lvm-gal__item img, .lvm-gal-{{ sid }} .lvm-gal__item svg { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .6s ease; }
  .lvm-gal-{{ sid }} .lvm-gal__item:hover img { transform: scale(1.04); }
  .lvm-gal-{{ sid }} .lvm-gal__caption { position: absolute; left: 0; right: 0; bottom: 0; padding: 28px 12px 12px; font-family: var(--font-body--family);
    font-size: 12px; letter-spacing: .06em; text-transform: uppercase; background: linear-gradient(transparent, rgb(0 0 0 / 45%)); }
  @media (min-width: 900px) {
    .lvm-gal-{{ sid }} .lvm-gal__track { grid-auto-flow: row; grid-template-columns: repeat(4, 1fr); max-width: 1320px; margin: 0 auto; padding: 0 40px; overflow: visible; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Lovaire fotogalerij",
  "settings": [
    { "type": "text", "id": "heading", "label": "Kop", "default": "#LovaireGlow" },
    { "type": "text", "id": "subheading", "label": "Ondertitel (cursief)", "default": "Zo dragen jullie het" },
    { "type": "color", "id": "background", "label": "Achtergrond", "default": "#f8f6f3" },
    { "type": "range", "id": "padding_top", "label": "Ruimte boven", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Ruimte onder", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Foto",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Foto" },
        { "type": "product", "id": "product", "label": "Product (link)" },
        { "type": "text", "id": "caption", "label": "Onderschrift (optioneel)" }
      ]
    }
  ],
  "presets": [{ "name": "Lovaire fotogalerij", "blocks": [{ "type": "photo" }, { "type": "photo" }, { "type": "photo" }, { "type": "photo" }] }]
}
{% endschema %}
