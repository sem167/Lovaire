                "pill_1_emoji": "⏱️",
                "pill_1_text": "Uitgroei gecamoufleerd in 5 seconden",
                "pill_2_emoji": "💧",
                "pill_2_text": "Waterproof, zonder plakkerig spraygevoel",
                "pill_3_emoji": "✨",
                "pill_3_text": "Ingebouwd sponsje – precies en zonder knoeien",
                "restyle_section": true,
                "button_color": "#6ab04c",
                "button_hover_color": "#5c9d40"
