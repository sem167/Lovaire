                    "verz_t"
                  ]
                },
                "ret": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Retourneren",
                    "open_by_default": false,
                    "icon": "none"
                  },
                  "blocks": {
                    "reto_t": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Je kunt ongeopende producten binnen 30 dagen na ontvangst retourneren. Voor hygiëneproducten zoals cosmetica en ondergoed gelden aparte voorwaarden: zie <a href=\"/pages/ruilen-en-retourneren\">hygiëneproducten</a>. Alle stappen vind je op onze pagina <a href=\"/pages/bestellingen-en-levering-1\">ruilen en retourneren</a>.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "rte",
                        "font": "var(--font-body--family)",
                        "color": "var(--color-foreground)",
                        "wrap": "pretty"
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "reto_t"
                  ]
                },
                "pay": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Veilig betalen",
                    "open_by_default": false,
                    "icon": "none"
                  },
                  "blocks": {
                    "veil_t": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Je betaalt via de beveiligde checkout van Shopify, onder andere met iDEAL en Klarna. Wij zien of bewaren je betaalgegevens nooit.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "rte",
                        "font": "var(--font-body--family)",
                        "color": "var(--color-foreground)",
                        "wrap": "pretty"
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "veil_t"
                  ]
                },
                "help": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Vragen? We helpen je graag",
                    "open_by_default": false,
                    "icon": "none"
                  },
                  "blocks": {
                    "vrag_t": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Mail ons via onze <a href=\"/pages/contact\">contactpagina</a>. Onze Nederlandse klantenservice is 24/7 voor je bereikbaar.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "rte",
                        "font": "var(--font-body--family)",
                        "color": "var(--color-foreground)",
                        "wrap": "pretty"
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "vrag_t"
                  ]
                }
              },
              "block_order": [
                "ship",
                "ret",
                "pay",
                "help"
              ]
