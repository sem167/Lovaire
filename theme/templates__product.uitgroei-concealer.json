    "gebruik": {
      "type": "lovaire-tekst-foto",
      "settings": {
        "heading": "Zo gebruik je het",
        "text": "<p><strong>1.</strong> Draai de dop eraf en druk het sponsje in het dopje om kleur op te nemen.</p><p><strong>2.</strong> Dep het direct op droge uitgroei, grijze haartjes of dunne plekjes.</p><p><strong>3.</strong> Werk van binnen naar buiten tot je de gewenste dekking hebt.</p><p><strong>Pro-tip:</strong> dep langs je scheiding en haarlijn voor voller ogend haar.</p>",
        "full_bleed": true,
